      value: 
      objectReference: {fileID: 905979242, guid: e669082add788c849b22e72acc48f0c8, type: 3}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: typingSound
      value: 
      objectReference: {fileID: 8300000, guid: 130654a53c1dda34796fc2eeb085e2a4, type: 3}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueMark
      value: 
      objectReference: {fileID: 200926622}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: textBoxPortrait
      value: 
      objectReference: {fileID: 314552463}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: showDialogueOnlyOnce
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: portraitSprites.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "Has llegado justo a tiempo! Acabo de recordar que en una de estas cajas
        dej\xE9 algo que te ser\xE1 muy \xFAtil."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "Cuando lo recojas, activa la palanca que tienes justo detr\xE1s para
        continuar con tu camino."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: Hmm? Que como se tantas cosas? Es complicado la verdad.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: Tu recoge lo que hay en la caja, mueve la palanca y sigamos, de acuerdo?
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "Se que desconf\xEDas de mi, pero debes hacerlo. Me se este sitio como
        la palma de mi mano."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: "Por ahora solo te dir\xE9 que, he pasado por algo muy parecido a lo
        que est\xE1s viviendo. Y a lo que te queda por vivir."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[6]
      value: "As\xED que conf\xEDa en m\xED, s\xED? Qui\xE9n sabe, quiz\xE1 hasta
        terminemos siendo grandes <color=yellow>amigos</color>."
      objectReference: {fileID: 0}
