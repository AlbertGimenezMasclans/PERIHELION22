      objectReference: {fileID: 1110948326, guid: e669082add788c849b22e72acc48f0c8, type: 3}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: textField1
      value: 
      objectReference: {fileID: 1596416314}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: blinkSprite
      value: 
      objectReference: {fileID: 905979242, guid: e669082add788c849b22e72acc48f0c8, type: 3}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: typingSound
      value: 
      objectReference: {fileID: 8300000, guid: 130654a53c1dda34796fc2eeb085e2a4, type: 3}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueMark
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: textBoxPortrait
      value: 
      objectReference: {fileID: 314552463}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: showDialogueOnlyOnce
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: portraitSprites.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "Hola. \xBFTe acuerdas que antes te dije que estabas a unas salas de
        algo muy guay?"
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "Bueno pues resulta que es esta sala de aqu\xED delante y no es tan
        guay."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Lo que vas a ver es algo bastante <color=yellow>fuerte</color> y <color=yellow>cargado</color>
        de informaci\xF3n."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Lo se todo de ti, pero no pod\xEDa dec\xEDrte nada. No quer\xEDa que
        lo supieras tan pronto."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "Te debo muchas explicaciones y te las dar\xE9. Pero primero... mira
        lo que hay dentro."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: A partir de ahora, te  ayudare a encontrar la <color=yellow>verdad</color>.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[6]
      value: "Solo... prep\xE1rate. Porque lo que vas a ver puede cambiarlo todo."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[7]
      value: Y lo siento. De verdad.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[8]
      value: "Solo digo que no has sido el \xFAnic@ en probarlas, pero me alegra
        que funcionen contigo..."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[9]
      value: "\xA1Y ya s\xE9 que no tengo piernas, no me lo recuerdes!"
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[10]
      value: "Tuve que \u201Cprobarlas\u201D con las manos. Recalco que las \u201Cprob\xE9\u201D
        porque se me cayeron unos cuantos tornillos."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[11]
      value: Muchos lo llaman <color=yellow>potar</color>, pero yo no puedo hacer
        eso.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[12]
      value: "\xBFO s\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: portraitSprites.Array.data[0]
      value: 
      objectReference: {fileID: 1110948326, guid: e669082add788c849b22e72acc48f0c8, type: 3}
