      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: secondTimeDialogueLines.Array.data[0]
      value: A que esperas? Salta y ve a por los Kreds.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: secondTimeDialogueLines.Array.data[1]
      value: Que, te pensabas que te iba dejar a tu suerte en un sitio como este?
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: secondTimeDialogueLines.Array.data[2]
      value: Tu flipas colega!
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
