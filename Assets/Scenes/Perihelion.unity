      value: 1.85
      objectReference: {fileID: 0}
    - target: {fileID: 5669827584585362950, guid: e1d6756a422cc93468deda2dbd0168df, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: Has conseguido el <color=red>Shooting Krystal</color>!
      objectReference: {fileID: 0}
    - target: {fileID: 5669827584585362950, guid: e1d6756a422cc93468deda2dbd0168df, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: Ahora ya puedes disparar por tu... <color=yellow>ojo</color>?
      objectReference: {fileID: 0}
    - target: {fileID: 5669827584585362950, guid: e1d6756a422cc93468deda2dbd0168df, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: 'Pulsa <sprite name="Zinput"> para disparar, puedes romper objetos e
        interactuar con cosas mas lejanas!

        Manten pulsado <sprite name="Xinput">
        para abrir el menu de <color=#7bf688>habilidades</color>'
      objectReference: {fileID: 0}
    - target: {fileID: 5669827584585362950, guid: e1d6756a422cc93468deda2dbd0168df, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: 'Selecciona la habiliadad para usarla.

        Prueba a disparar a
        paredes sospechosas o cosas que haya en ellas!'
      objectReference: {fileID: 0}
    - target: {fileID: 6071182378240184559, guid: e1d6756a422cc93468deda2dbd0168df, type: 3}
      propertyPath: m_Size.x
      value: 0.12046837
      objectReference: {fileID: 0}
