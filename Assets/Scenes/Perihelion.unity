--- !u!1001 &390420979
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1932235941}
    m_Modifications:
    - target: {fileID: 1504044926643777578, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: m_Name
      value: Escritorio
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: textBox
      value: 
      objectReference: {fileID: 2002947157}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: Input_TB
      value: 
      objectReference: {fileID: 692248173}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: textField2
      value: 
      objectReference: {fileID: 1717813395}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueEndSound
      value: 
      objectReference: {fileID: 8300000, guid: 37782a1da832ff84aa8608f5c1d0f5cb, type: 3}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueAdvanceSound
      value: 
      objectReference: {fileID: 8300000, guid: 6be0bd76ddbeb044cb375ea7ba0397bc, type: 3}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: showDialogueOnlyOnce
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 26
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: El ordenador parece estar <color=yellow>encendido</color>.
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "Hay una carpeta abierta con m\xFAltiples videos."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Uno se reproduce autom\xE1ticamente en cuanto miras la pantalla."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "<color=yellow>Video n2:</color>\n\"El sujeto PH-01 ha iniciado su fase
        de 'fabricaci\xF3n'\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "\"Si todo va seg\xFAn lo previsto, en dos meses esta fase habr\xE1
        terminado y podremos comenzar la fase de 'pruebas'\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: "\"Aun as\xED, algunos estamos inquietos por la situaci\xF3n en la que
        nos encontramos\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[6]
      value: "\"Marcos est\xE1 al borde del colapso. Michael y yo intentamos calmarlo,
        hacerle entender por qu\xE9 lo fabricamos... pero no hay manera\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[7]
      value: "\"\xBFA qui\xE9n quiero enga\xF1ar? Yo estoy m\xE1s nervioso que nadie\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[8]
      value: "<color=yellow>Video n14:</color>\n\"La fabricaci\xF3n ha terminado
        y la fase de pruebas comenz\xF3 ayer\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[9]
      value: "\"Nos han llegado m\xE1s \xF3rdenes de #$L@R... no es lo que esper\xE1bamos.
        Al menos, no lo que yo esperaba\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[10]
      value: "\"Se nos echa el tiempo encima y, para colmo, se han llevado a Kilian
        y a Ethan a otra zona de investigaci\xF3n\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[11]
      value: '"Mis sentimientos hacia esta... <color=yellow>cosa</color> no han cambiado.
        Y no creo que lo hagan".'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[12]
      value: '<color=yellow>Video n21:</color>

        "Han pasado tres semanas
        y hemos avanzado ligeramente, pero nos hemos estancado".'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[13]
      value: '"Por mucho conocimiento que tengamos... NO. HAY. MANERA".'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[14]
      value: "\"No logramos adaptar el modelo de reconocimiento facial del sujeto.\nAdem\xE1s,
        #$L@R no entra en raz\xF3n. Lo quiere ya...\""
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[15]
      value: '"Estamos acabados".'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[16]
      value: "<color=yellow>Video n34:</color>\n\"Hoy es el d\xEDa en que #$L@R vendr\xE1
        a ver a 'PH-01'\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[17]
      value: "\"M\xE1s de la mitad del equipo ha abandonado. Solo quedamos David,
        Edgar y yo, Eldrick\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[18]
      value: "\"Afortunadamente, hemos logrado que 'PH-01' piense por s\xED mismo...
        aunque sin salirse del protocolo\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[19]
      value: "\"Tambi\xE9n, sus capacidades sensoriales funcionan como deben. En
        cambio, los objetos clave no\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[20]
      value: "\"Es como si intentaran evolucionar por s\xED solos. A veces se ejecutan
        simult\xE1neamente, otras veces hacen lo contrario de lo previsto, y otras...\""
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[21]
      value: "\"Espero que a #$L@R no le importe, pero seguramente vayamos a confisc\xE1rselas\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[22]
      value: "Despu\xE9s de eso, aparece una figura misteriosa detr\xE1s de la persona
        que hablaba, mirando a c\xE1mara con una siniestra sonrisa."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[23]
      value: "Dispara hacia la c\xE1mara, y el video se corta bruscamente."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[24]
      value: 'Luego, el ordenador se apaga.

        Intentas encenderlo de nuevo,
        pero no hay manera.'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[25]
      value: "Esa figura con la sonrisa siniestra... se te hace familiar.\nPero no
        logras recordar d\xF3nde la has visto."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[26]
      value: 'Esa figura con la sonrisa siniestra, se te hace familiar.

        Pero
        no logras descifrar donde la has visto.'
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: headlessDialogueLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: secondTimeDialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: secondTimeDialogueLines.Array.data[0]
      value: El ordenador <color=yellow>no</color> se enciende.
      objectReference: {fileID: 0}
