      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: portraitSprites.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: Hola, veo que has despertado. Un placer conocerte.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "As\xED que t\xFA eres el <color=yellow>Protagonista</color> de esta
        historia..."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "A qu\xE9 historia me refiero? Hmm... Parece que no recuerdas nada.
        Lo siento, no puedo ayudarte con eso."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Desactivar\xE9 este l\xE1ser para que puedas seguir adelante. \nAseg\xFArate
        de leer el cartel que hay m\xE1s adelante, por favor."
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: Espero que tengas un buen viaje.
      objectReference: {fileID: 0}
    - target: {fileID: 6579526728564863465, guid: fedc56387f80e064e989fccee490f7e7, type: 3}
      propertyPath: portraitSprites.Array.data[0]
