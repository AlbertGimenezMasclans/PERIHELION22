      propertyPath: dialogueLines.Array.data[0]
      value: "Hay muchos libros en esta estanter\xEDa."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "No llegas hasta lo m\xE1s alto, pero por lo que parece, hay libros
        de todo tipo."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Sobre todo, conocimiento en tecnolog\xEDa avanzada y algunos en un
        <color=yellow>lenguaje</color> que no pareces comprender."
      objectReference: {fileID: 0}
    - target: {fileID: 2114765730648731509, guid: 26dad3e0b21623f4b8d9fddedac739f3, type: 3}
